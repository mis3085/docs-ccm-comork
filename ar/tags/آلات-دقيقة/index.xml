        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d8%a7%d9%84%d8%af%d9%82%d8%a9-%d9%88%d8%a7%d9%84%d8%aa%d9%86%d9%88%d8%b9-%d9%81%d9%8a-%d8%a7%d9%84%d8%b7%d8%ad%d9%86-%d8%a7%d9%84%d8%a3%d8%b3%d8%b7%d9%88%d8%a7%d9%86%d9%8a&#34; aria-label=&#34;رابط&#34;&gt;#&lt;/a&gt;
